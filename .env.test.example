NODE_ENV=test
HOST=0.0.0.0
PORT=3001
URL_PREFIX=/api
LOG_LEVEL=silent
PERSISTENCE_PROVIDER=postgres
REDIS_ENABLED=true
POSTGRES_HOST=test-postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=express_test
POSTGRES_PASSWORD=express_test
POSTGRES_DATABASE=express_test
POSTGRES_SCHEMA=public
POSTGRES_CONNECT_TIMEOUT_MS=3000
REDIS_HOST=test-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_MS=3000
STARTUP_CONNECT_RETRIES=1
STARTUP_RETRY_DELAY_MS=250
JWT_SECRET=test-only-secret-at-least-thirty-two-characters
JWT_EXPIRES_IN_SECONDS=60
BCRYPT_ROUNDS=4
