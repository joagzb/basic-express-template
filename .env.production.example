NODE_ENV=production
HOST=0.0.0.0
PORT=3000
URL_PREFIX=/api
LOG_LEVEL=info
PERSISTENCE_PROVIDER=postgres
REDIS_ENABLED=true
POSTGRES_HOST=prod-postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=express_prod
POSTGRES_PASSWORD=replace-with-a-secret
POSTGRES_DATABASE=express_prod
POSTGRES_SCHEMA=public
POSTGRES_CONNECT_TIMEOUT_MS=3000
REDIS_HOST=prod-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-secret
REDIS_CONNECT_TIMEOUT_MS=3000
STARTUP_CONNECT_RETRIES=1
STARTUP_RETRY_DELAY_MS=250
JWT_SECRET=replace-with-at-least-thirty-two-random-characters
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
BCRYPT_ROUNDS=12
